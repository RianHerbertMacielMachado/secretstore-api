# ─── SERVIDOR ────────────────────────────────────────────────
PORT=3000

# ─── BANCO DE DADOS (Railway fornece DATABASE_URL automaticamente) ───
DATABASE_URL=postgresql://postgres:SENHA@HOST:PORTA/railway

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=SUA_CHAVE_SECRETA_AQUI_MUDE_ISSO_123456
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# ─── ADMIN PADRÃO (criado no seed) ──────────────────────────
ADMIN_EMAIL=admin@secretstore.com
ADMIN_PASSWORD=Admin@2024!
